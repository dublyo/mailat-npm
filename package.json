{
  "name": "@dublyo/mailat",
  "version": "1.0.1",
  "description": "Tiny, dependency-free client for sending email through Mailat (mailat.co), the open-source Amazon SES email platform",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test tests/client.test.mjs tests/webhooks.test.mjs tests/no-global-crypto.test.mjs tests/cjs.test.cjs",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "email",
    "mailat",
    "mailat.co",
    "email-api",
    "transactional-email",
    "amazon-ses",
    "ses",
    "webhooks",
    "nextjs",
    "nuxt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dublyo/mailat-npm.git"
  },
  "homepage": "https://mailat.co",
  "bugs": {
    "url": "https://github.com/dublyo/mailat-npm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
